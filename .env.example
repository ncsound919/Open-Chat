# ──── Local secrets for Open-Chat dev/Electron (gitignored) ────────────────
#
# SECURITY: VITE_* vars are inlined into the client bundle and are therefore
# EXTRACTABLE from any built APK. Do NOT put real credentials here. Access
# tokens (Draymond CRON_SECRET, Hermes API_SERVER_KEY) are entered at runtime
# in Settings and stored on-device (optionally encrypted — see Settings →
# Security → "Encrypt local data"). These env vars are dev conveniences only.

# Draymond dev host override (USB-debug builds via `adb reverse tcp:3444`).
VITE_DRAYMOND_URL=http://localhost:3444

# Draymond voice proxy port (hermes-proxy media + AetherDesk voice).
VITE_DRAYMOND_VOICE_PORT=8648
