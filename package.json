{
  "name": "open-chat",
  "main": "electron/main.js",
  "version": "1.0.0",
  "description": "Private chat app for autonomous agents (OpenClaw, Hermes)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --win --mac --linux",
    "android:dev": "vite build && npx cap sync android && npx cap open android",
    "android:build": "vite build && npx cap sync android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^30.0.1",
    "vite": "^5.0.8",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "chat",
    "agent",
    "openclaw",
    "hermes",
    "ai",
    "local-first"
  ],
  "author": "ncsound919",
  "license": "MIT"
}
