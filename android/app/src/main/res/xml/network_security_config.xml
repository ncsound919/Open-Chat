<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for Open Chat.
  Allows cleartext (HTTP) traffic to localhost addresses used by local AI agents.
  All other traffic requires HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext for local agent servers -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Android emulator maps 10.0.2.2 to host machine's localhost -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
