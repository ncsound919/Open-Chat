<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for Open Chat.
  Open Chat is a local-first app: agents run on your LAN (Draymond, Hermes,
  OpenClaw, Ollama, llama.cpp, etc.) and are reached over plain HTTP on
  private addresses, which Android blocks by default. We therefore permit
  cleartext traffic app-wide. Traffic to public/cloud endpoints should still
  use HTTPS; the app never sends secrets over cleartext to remote hosts.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
