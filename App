            style={{ width:"100%", background:b.color, color:"#0d0d14", border:"none", borderRadius:12, padding:"13px", fontSize:15, fontWeight:600, cursor:"pointer" }}
          >
            Save & Reconnect
          </button>
        </div>
      </div>
    );
  };

  // ══════════════════════════════════════════════════════════════════════════
  // ── Inbox ──────────────────────────────────────────────────────────────────
