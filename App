        <div style={{ display:"flex", alignItems:"center", gap:12, padding:"52px 16px 16px", borderBottom:"1px solid #1a1a26", background:"#111118" }}>
          <button onClick={() => { setCfgBot(null); setShowCfg(false); }} style={{ background:"none", border:"none", color:b.color, cursor:"pointer", display:"flex" }}><BackIcon /></button>
          <div>
            <div style={{ fontWeight:600, fontSize:16, color:"#f0f0f5" }}>{b.name} Settings</div>
            <div style={{ fontSize:12, color:"#444455" }}>
              {b.protocol === "openclaw" ? "OpenClaw WebSocket" : "Hermes HTTP (OpenAI-compatible)"}
            </div>
          </div>
        </div>
        <div style={{ flex:1, overflowY:"auto", padding:20, display:"flex", flexDirection:"column", gap:16 }}>
          <div>
            <span style={label}>Host</span>
            <input style={inputStyle} value={form.host} onChange={set("host")} placeholder="127.0.0.1" />
          </div>
          <div>
            <span style={label}>Port</span>
            <input style={inputStyle} value={form.port} onChange={set("port")} placeholder={b.protocol === "openclaw" ? "18789" : "8642"} />
          </div>
          <div>
            <span style={label}>{b.protocol === "openclaw" ? "Gateway Token (OPENCLAW_GATEWAY_TOKEN)" : "API Key (API_SERVER_KEY)"}</span>
            <input style={inputStyle} value={form.token} onChange={set("token")} placeholder="Leave blank if none set" type="password" />
          </div>
          <div style={{ background:"#1a1a26", borderRadius:10, padding:"12px 14px" }}>
            <div style={{ fontSize:11, color:"#555568", lineHeight:1.7, fontFamily:"monospace" }}>
