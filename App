// ─── OpenClaw WebSocket ───────────────────────────────────────────────────────
class OpenClawClient {
  constructor(host, port, token) {
    this.url = `ws://${host}:${port}`;
    this.token = token;
    this.ws = null;
    this.pendingReqs = new Map();
    this.onStatusChange = null;
    this._destroyed = false;
    this._reconnectTimer = null;
  }

  connect() {
    return new Promise((resolve, reject) => {
      if (this._destroyed) return reject(new Error("destroyed"));
      this.ws = new WebSocket(this.url);
      this.ws.onopen = () => {
        const id = uuid();
        this.ws.send(JSON.stringify({
          type:"req", id, method:"connect",
          params:{
            minProtocol:3, maxProtocol:3, role:"operator", scopes:["chat"],
            client:{ id:"openchat", version:"1.0.0", platform:"web", mode:"operator" },
            ...(this.token ? { auth:{ token:this.token } } : {}),
          },
        }));
      };
      this.ws.onmessage = (e) => {
        let msg; try { msg = JSON.parse(e.data); } catch { return; }
        if (msg.type === "res" && msg.payload?.type === "hello-ok") {
          this.onStatusChange?.("connected"); resolve(); return;
        }
        if (msg.type === "res" && msg.error && !this._resolved) {
          reject(new Error(msg.error?.message || "connect failed")); return;
        }
        if (msg.type === "event" && msg.event === "agent") {
          const delta = msg.payload?.delta ?? msg.payload?.text ?? "";
          const runId = msg.payload?.runId;
          for (const [, req] of this.pendingReqs) {
            if (!req.runId || req.runId === runId) { req.runId = runId; req.onChunk?.(delta); break; }
          }
          return;
        }
        if (msg.type === "res" && msg.method === "agent") {
          const req = this.pendingReqs.get(msg.id);
          if (req) { this.pendingReqs.delete(msg.id); req.resolve(msg.payload?.summary || ""); }
          return;
        }
        if (msg.type === "res" && msg.method === "chat.send") {
          const req = this.pendingReqs.get(msg.id);
          if (req) req.runId = msg.payload?.runId;
        }
      };
      this.ws.onclose = () => {
        this.onStatusChange?.("disconnected");
        if (!this._destroyed) {
          // Auto-reconnect after 5 s
          this._reconnectTimer = setTimeout(() => {
            if (!this._destroyed) { this.onStatusChange?.("connecting"); this.connect().catch(() => {}); }
          }, 5000);
        }
      };
      this.ws.onerror = () => { this.onStatusChange?.("error"); reject(new Error("ws error")); };
    });
  }

  send(text, onChunk) {
    return new Promise((resolve, reject) => {
      if (this.ws?.readyState !== WebSocket.OPEN) { reject(new Error("Not connected")); return; }
      const id = uuid();
      this.pendingReqs.set(id, { resolve, reject, onChunk, runId: null });
      this.ws.send(JSON.stringify({ type:"req", id, method:"chat.send", params:{ text, idempotencyKey:uuid() } }));
    });
  }

  disconnect() {
    this._destroyed = true;
    clearTimeout(this._reconnectTimer);
    this.ws?.close();
    this.ws = null;
  }
}

// ─── Hermes HTTP/SSE ──────────────────────────────────────────────────────────
async function hermesStream(host, port, token, messages, onChunk, signal) {
  const res = await fetch(`http://${host}:${port}/v1/chat/completions`, {
    method:"POST", signal,
    headers:{ "Content-Type":"application/json", ...(token ? { Authorization:`Bearer ${token}` } : {}) },
    body: JSON.stringify({ model:"hermes-agent", messages, stream:true }),
  });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const reader = res.body.getReader();
  const dec = new TextDecoder();
  let full = "";
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    for (const line of dec.decode(value, { stream:true }).split("\n")) {
      if (!line.startsWith("data: ")) continue;
      const data = line.slice(6).trim();
      if (data === "[DONE]") return full;
      try {
        const delta = JSON.parse(data).choices?.[0]?.delta?.content || "";
        if (delta) { full += delta; onChunk(delta); }
      } catch {}
    }
  }
  return full;
}

// ─── Zero-dep Markdown renderer ───────────────────────────────────────────────
// Handles: ```code```, # headings, **bold**, *italic*, `inline`, - lists, 1. lists, ---
function SimpleMarkdown({ text }) {
  if (!text) return null;
  const lines = text.split("\n");
  const els = [];
  let i = 0;

  // Inline spans: `code`, **bold**, *italic*
  const inline = (str, key) => {
    const parts = [];
    const re = /(`[^`]+`|\*\*[^*]+\*\*|\*[^*]+\*)/g;
    let last = 0, m, idx = 0;
    while ((m = re.exec(str)) !== null) {
      if (m.index > last) parts.push(str.slice(last, m.index));
      const tok = m[0];
      if (tok[0] === "`")
        parts.push(<code key={idx++} style={{ background:"#ffffff18", borderRadius:4, padding:"1px 5px", fontFamily:"monospace", fontSize:"0.88em" }}>{tok.slice(1,-1)}</code>);
      else if (tok.startsWith("**"))
        parts.push(<strong key={idx++}>{tok.slice(2,-2)}</strong>);
      else
        parts.push(<em key={idx++}>{tok.slice(1,-1)}</em>);
      last = m.index + tok.length;
    }
    if (last < str.length) parts.push(str.slice(last));
    return <span key={key}>{parts}</span>;
  };

  while (i < lines.length) {
    const line = lines[i];

    // Fenced code block
    if (line.startsWith("```")) {
      const lang = line.slice(3).trim();
      const codeLines = [];
      i++;
      while (i < lines.length && !lines[i].startsWith("```")) { codeLines.push(lines[i]); i++; }
      els.push(
        <div key={i} style={{ margin:"8px 0", borderRadius:8, overflow:"hidden", border:"1px solid #ffffff15" }}>
          {lang && <div style={{ background:"#ffffff0c", padding:"2px 10px", fontSize:11, color:"#777", fontFamily:"monospace" }}>{lang}</div>}
          <pre style={{ background:"#0a0a10", padding:"10px 12px", margin:0, overflowX:"auto", fontSize:13, fontFamily:"monospace", lineHeight:1.6, color:"#e2e2f0" }}>
            <code>{codeLines.join("\n")}</code>
          </pre>
        </div>
      );
      i++; continue;
    }

    // Heading
    const hm = line.match(/^(#{1,3})\s+(.*)/);
    if (hm) {
      const sz = [17,15,14][hm[1].length - 1];
      els.push(<div key={i} style={{ fontWeight:700, fontSize:sz, margin:"10px 0 3px", color:"#f0f0f5" }}>{inline(hm[2], i)}</div>);
      i++; continue;
    }

    // Bullet list — collect consecutive items
    if (/^[-*]\s/.test(line)) {
      const items = [];
      while (i < lines.length && /^[-*]\s/.test(lines[i])) {
        items.push(<li key={i} style={{ marginBottom:2 }}>{inline(lines[i].slice(2), i)}</li>);
        i++;
      }
      els.push(<ul key={`ul${i}`} style={{ paddingLeft:18, margin:"5px 0" }}>{items}</ul>);
      continue;
    }

    // Numbered list
    if (/^\d+\.\s/.test(line)) {
      const items = [];
      while (i < lines.length && /^\d+\.\s/.test(lines[i])) {
        items.push(<li key={i} style={{ marginBottom:2 }}>{inline(lines[i].replace(/^\d+\.\s/,""), i)}</li>);
        i++;
      }
      els.push(<ol key={`ol${i}`} style={{ paddingLeft:18, margin:"5px 0" }}>{items}</ol>);
      continue;
    }

    // HR
    if (/^---+$/.test(line)) {
      els.push(<hr key={i} style={{ border:"none", borderTop:"1px solid #ffffff12", margin:"8px 0" }} />);
      i++; continue;
    }

    // Empty line → small gap
    if (!line.trim()) {
      if (els.length) els.push(<div key={i} style={{ height:5 }} />);
      i++; continue;
    }

    // Paragraph
    els.push(<div key={i} style={{ lineHeight:1.6 }}>{inline(line, i)}</div>);
    i++;
  }

  return <div style={{ fontSize:15 }}>{els}</div>;
}

// ─── useAutoResize ────────────────────────────────────────────────────────────
function useAutoResize(value) {
  const ref = useRef(null);
  useEffect(() => {
    const el = ref.current;
    if (!el) return;
    el.style.height = "auto";
    el.style.height = Math.min(el.scrollHeight, 120) + "px";
  }, [value]);
  return ref;
}

