// ─── App ──────────────────────────────────────────────────────────────────────
export default function App() {
  const [bots, setBots]           = useState(loadBots);
  const [history, setHistory]     = useState(loadHist);
  const [activeId, setActiveId]   = useState(null);
  const [input, setInput]         = useState("");
  const [streaming, setStreaming] = useState(false);
  const [statuses, setStatuses]   = useState({});   // botId → status string
  const [search, setSearch]       = useState("");
  const [showCfg, setShowCfg]     = useState(false);  // settings panel
  const [cfgBot, setCfgBot]       = useState(null);   // bot being edited
  const [showMenu, setShowMenu]   = useState(false);

  const bottomRef  = useRef(null);
  const inputRef   = useRef(null);
  const clawRefs   = useRef({});  // botId → OpenClawClient
  const abortRef   = useRef(null); // Hermes AbortController
  const streamBuf  = useRef("");

  const bot = bots.find(b => b.id === activeId);
  const messages = history[activeId] || [];

  // ── Persist ──────────────────────────────────────────────────────────────
  useEffect(() => { saveHist(history); }, [history]);
  useEffect(() => { saveBots(bots); }, [bots]);
  useEffect(() => {
    if (activeId) bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [history, streaming, activeId]);

  // ── Set status ────────────────────────────────────────────────────────────
  const setStatus = useCallback((id, s) => setStatuses(p => ({ ...p, [id]: s })), []);

  // ── Connect OpenClaw ──────────────────────────────────────────────────────
  const connectClaw = useCallback(async (b) => {
    if (clawRefs.current[b.id]) {
      clawRefs.current[b.id].disconnect();
      delete clawRefs.current[b.id];
    }
    const client = new OpenClawClient(b.host, b.port, b.token);
    client.onStatusChange = (s) => setStatus(b.id, s);
    clawRefs.current[b.id] = client;
    setStatus(b.id, "connecting");
    try { await client.connect(); }
    catch (e) { setStatus(b.id, "error"); }
  }, [setStatus]);

  // Auto-connect OpenClaw bots on mount / bot change
  useEffect(() => {
    bots.filter(b => b.protocol === "openclaw").forEach(b => {
      if (!clawRefs.current[b.id]) connectClaw(b);
    });
    // Hermes: just probe health
    bots.filter(b => b.protocol === "hermes").forEach(b => {
      setStatus(b.id, "connecting");
      fetch(`http://${b.host}:${b.port}/v1/health`, {
        headers: b.token ? { Authorization: `Bearer ${b.token}` } : {},
        signal: AbortSignal.timeout(3000),
      })
        .then(r => setStatus(b.id, r.ok ? "connected" : "error"))
        .catch(() => setStatus(b.id, "disconnected"));
    });
  }, []); // eslint-disable-line

  // ── Add message helper ────────────────────────────────────────────────────
  function addMsg(botId, msg) {
    setHistory(p => ({ ...p, [botId]: [...(p[botId] || []), msg] }));
  }

  function updateLastMsg(botId, patch) {
    setHistory(p => {
      const msgs = [...(p[botId] || [])];
      if (!msgs.length) return p;
      msgs[msgs.length - 1] = { ...msgs[msgs.length - 1], ...patch };
      return { ...p, [botId]: msgs };
    });
  }

  // ── Send ──────────────────────────────────────────────────────────────────
  async function sendMsg() {
    const text = input.trim();
    if (!text || !bot || streaming) return;
    setInput("");
    setStreaming(true);
    streamBuf.current = "";

    const userMsg = { id: uuid(), role: "user", text, time: ts(), read: false };
    addMsg(bot.id, userMsg);

    // Placeholder streaming message
    const botMsgId = uuid();
    addMsg(bot.id, { id: botMsgId, role: "bot", text: "", time: ts(), streaming: true });

    try {
      if (bot.protocol === "openclaw") {
        const client = clawRefs.current[bot.id];
        if (!client || client.ws?.readyState !== WebSocket.OPEN) {
          throw new Error("OpenClaw not connected — check Settings");
        }
        await client.send(text, (delta) => {
          streamBuf.current += delta;
          updateLastMsg(bot.id, { text: streamBuf.current, streaming: true });
        });
        updateLastMsg(bot.id, { text: streamBuf.current || "✓", streaming: false });
        // mark user msg read
        setHistory(p => ({
          ...p,
          [bot.id]: (p[bot.id] || []).map(m => m.id === userMsg.id ? { ...m, read: true } : m),
        }));

      } else if (bot.protocol === "hermes") {
        abortRef.current = new AbortController();
        const prior = (history[bot.id] || [])
          .filter(m => m.role === "user" || (m.role === "bot" && !m.streaming))
          .slice(-20)
          .map(m => ({ role: m.role === "user" ? "user" : "assistant", content: m.text }));
        prior.push({ role: "user", content: text });

        await hermesStream(
          bot.host, bot.port, bot.token, prior,
          (delta) => {
            streamBuf.current += delta;
            updateLastMsg(bot.id, { text: streamBuf.current, streaming: true });
          },
          abortRef.current.signal,
        );
        updateLastMsg(bot.id, { text: streamBuf.current, streaming: false });
        setHistory(p => ({
          ...p,
          [bot.id]: (p[bot.id] || []).map(m => m.id === userMsg.id ? { ...m, read: true } : m),
        }));
      }
    } catch (e) {
      const errText = e.name === "AbortError" ? "[interrupted]" : `⚠ ${e.message}`;
      updateLastMsg(bot.id, { text: errText, streaming: false, error: true });
    } finally {
      setStreaming(false);
    }
  }

  function interrupt() {
    abortRef.current?.abort();
    setStreaming(false);
  }

  // ── Open chat ─────────────────────────────────────────────────────────────
  function openChat(id) {
    setActiveId(id);
    setShowMenu(false);
    setHistory(p => ({ ...p, [id]: (p[id] || []).map(m => ({ ...m, _seen: true })) }));
    setTimeout(() => inputRef.current?.focus(), 80);
  }

  function clearChat(id) {
    setHistory(p => ({ ...p, [id]: [] }));
    setShowMenu(false);
  }

  // ── Settings helpers ──────────────────────────────────────────────────────
  function saveBot(updated) {
    setBots(p => p.map(b => b.id === updated.id ? updated : b));
    setCfgBot(null);
    setShowCfg(false);
    // Reconnect if needed
    if (updated.protocol === "openclaw") connectClaw(updated);
    else {
      setStatus(updated.id, "connecting");
      fetch(`http://${updated.host}:${updated.port}/v1/health`, {
        headers: updated.token ? { Authorization: `Bearer ${updated.token}` } : {},
        signal: AbortSignal.timeout(3000),
      })
        .then(r => setStatus(updated.id, r.ok ? "connected" : "error"))
        .catch(() => setStatus(updated.id, "disconnected"));
    }
  }

  const lastMsg = (id) => { const m = history[id] || []; return m[m.length - 1] || null; };
  const unread  = (id) => (history[id] || []).filter(m => m.role === "bot" && !m._seen).length;
  const filtered = bots.filter(b => b.name.toLowerCase().includes(search.toLowerCase()));

  // ══════════════════════════════════════════════════════════════════════════
  // ── Settings panel ────────────────────────────────────────────────────────
  const Settings = ({ b }) => {
